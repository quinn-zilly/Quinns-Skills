{
  "name": "quinns-skills",
  "description": "Quinn's personal Claude Code skills.",
  "version": "0.1.0",
  "author": {
    "name": "Quinn"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/plain-english-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading plain English..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/plain-english-reinforce.js\"",
            "timeout": 5,
            "statusMessage": "Reinforcing plain English..."
          }
        ]
      }
    ]
  }
}
